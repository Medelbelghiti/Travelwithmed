# Database (PostgreSQL, required)
DATABASE_URL="postgresql://postgres:POSTGRES_PASSWORD@localhost:5432/roamora?schema=public"

# Auth secret — generate one with: npx auth secret  (or a long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# Emails allowed to access /admin (comma separated)
ADMIN_EMAILS="admin@roamora.com"

# Public site URL — MUST be the production domain (drives sitemap, canonical, OpenGraph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Roamora"
NEXT_PUBLIC_SITE_TAGLINE="Plan smarter. Travel better."

# Plausible Analytics (optional, cookieless & GDPR-friendly). Leave empty to disable.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="yourdomain.com"
# NEXT_PUBLIC_PLAUSIBLE_SRC="https://plausible.io/js/script.js"
# For self-hosted Plausible, use your own URL, e.g. "https://analytics.yourdomain.com/js/script.js"

# Google Analytics 4 (optional). Leave empty to disable.
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Optional: seed admin password (defaults to "roamora-admin" when unset)
# SEED_ADMIN_PASSWORD="a-strong-password"